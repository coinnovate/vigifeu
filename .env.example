# Copier en .env (jamais commité — cf. .gitignore) et remplir.
# Chargé par systemd via EnvironmentFile=/opt/vigifeu/.env (deploy/vigifeu.service).

# --- Sources -----------------------------------------------------------------
# MAP_KEY FIRMS : https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# --- Carte (Lot 4/5) ---------------------------------------------------------
# Clé MapTiler (fond raster free-tier de la bêta). Injectée par le générateur dans
# data/site/static/carte-config.js UNIQUEMENT (jamais dans le HTML des fiches ni le
# dépôt). Sans clé, la carte se masque proprement et l'alternative texte reste.
# Console : https://cloud.maptiler.com/account/keys/
VIGIFEU_MAPTILER_KEY=

# --- Monitoring (Lot 1+) : un ping healthchecks.io par tâche, sur succès ---------
# Optionnels : laisser vide désactive le ping de la tâche concernée.
HEALTHCHECK_FIRMS_URL=
HEALTHCHECK_WEATHER_URL=
HEALTHCHECK_BACKFILL_URL=
HEALTHCHECK_COLLECTION_URL=
HEALTHCHECK_CONTEXT_URL=
HEALTHCHECK_ARCHIVE_URL=
HEALTHCHECK_FINALIZE_URL=
