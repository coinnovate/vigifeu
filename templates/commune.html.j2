{% extends "base.html.j2" %}
{#
  Fiche commune (Spec 03 §4). Complète même hors événement (§4.8) : c'est la valeur
  hors saison et le maillage SEO. Ton neutre — « aucune détection » n'est pas
  « aucun risque ». Phrases issues du lexique (via commune.py).
#}
{% block content %}
<article class="fiche-commune">

<header>
<h1>Incendies à {{ nom_dept }}</h1>
<p class="meta">
{% if population %}Population : {{ population }}{% if millesime %} (millésime {{ millesime }}){% endif %}. {% endif %}
{% if epci %}EPCI : {{ epci }}.{% endif %}
</p>
</header>

{# 4.2 Situation en cours — « suis-je concerné ? » #}
<section class="situation">
<h2>Situation en cours</h2>
{% if situation %}
{% for item in situation %}
<p>{{ item.phrase }}. {% if item.href %}<a href="{{ item.href }}">{{ item.lien }}</a>{% endif %}</p>
{% endfor %}
{% else %}
<p>{{ aucun_feu }}.</p>
{% endif %}
</section>

{# 4.3 Contexte du jour — VigiEau (armé) + sécheresse (dégradée) #}
<section class="contexte">
<h2>Contexte du jour</h2>
{% if contexte.vigieau %}<p>{{ contexte.vigieau }}.</p>{% endif %}
{% if contexte.meteo_forets %}<p>{{ contexte.meteo_forets }}.</p>{% endif %}
{% if contexte.fwi %}<p>{{ contexte.fwi }}.</p>{% endif %}
{% if contexte.secheresse_indispo %}
<p class="indispo">Danger sécheresse (Météo des forêts, FWI/DC) momentanément indisponible (source en cours d'intégration).</p>
{% endif %}
{% if not contexte.vigieau and not contexte.secheresse_indispo and not contexte.meteo_forets %}
<p class="calme">Aucune restriction ni alerte sécheresse en cours sur la commune.</p>
{% endif %}
</section>

{# 4.4 Historique incendies #}
<section class="historique">
<h2>Historique des incendies</h2>
<p>{{ historique.synthese }}.</p>
{% if historique.notables %}
<h3>Événements notables</h3>
<table>
<thead><tr><th>Année</th><th>Surface</th><th>Type</th></tr></thead>
<tbody>
{% for e in historique.notables %}
<tr><td>{{ e.annee }}</td><td>{% if e.surface %}{{ e.surface }} ha{% else %}—{% endif %}</td><td>{{ e.type or "—" }}</td></tr>
{% endfor %}
</tbody>
</table>
{% endif %}
{% if historique.suivis %}
<h3>Feux suivis par {{ marque }}</h3>
<ul>
{% for f in historique.suivis %}
<li>{{ f.phrase }} — <a href="{{ f.href }}">{{ f.lien }}</a></li>
{% endfor %}
</ul>
{% endif %}
</section>

{# Enjeux sensibles dans la commune (Spec 06 §4) — recensement AGRÉGÉ, permanent, jamais
   nominatif. Section absente tant qu'aucun référentiel POI n'est chargé (dégradé — P6). #}
{% if recensement_poi or not recensement_indispo %}
<section class="enjeux-commune">
<h2>Enjeux sensibles dans la commune</h2>
{% if recensement_poi %}
<p>{{ recensement_poi }}.</p>
{% else %}
<p class="calme">Aucun établissement sensible recensé dans la commune.</p>
{% endif %}
<p class="note">{{ recensement_reserve }}</p>
</section>
{% endif %}
{# 4.5 Exposition structurelle #}
{% if exposition %}
<section class="exposition">
<h2>Exposition structurelle</h2>
<p>{{ exposition }}.</p>
</section>
{% endif %}

{# 4.6 Réglementaire — catégorie declaree #}
{% if reglementaire %}
<section class="reglementaire">
<h2>Réglementaire</h2>
<ul>
{% for r in reglementaire %}
<li>{{ r }}</li>
{% endfor %}
</ul>
</section>
{% endif %}

{% if contrib_active %}
{# Photos de visiteurs de la commune (Spec 10 §7.4) — agrège les feux dont un hotspot
   contributif est dans la commune ; peuplé côté client, onglet masqué si aucune photo. #}
<section class="contributions" hidden>
<h2>Photos</h2>
<div class="photos-widget" data-sentifeu-photos="/api/contrib/commune/{{ code_insee }}/photos" data-lieu="{{ nom }}"></div>
</section>
{% endif %}

</article>
{% endblock %}
{% block scripts %}
{% if contrib_active %}<script src="/api/contrib/widget.js" defer></script>{% endif %}
{% endblock %}
