{% extends "base.html.j2" %}
{#
  Fiche feu (Spec 03 §3). Toutes les phrases métier viennent du lexique (via feu.py) ;
  ce gabarit n'apporte que la structure et les libellés de sections. Complet sans JS
  (P3) : la carte (§3.3) est un enrichissement, la synthèse en est l'alternative texte.
#}
{% block extra_head %}
<link rel="stylesheet" href="/static/css/maplibre-gl.css">
{% endblock %}
{% block content %}
{% if bandeau_archive %}
<div class="bandeau" role="note">{{ bandeau_archive }}</div>
{% endif %}

<article class="fiche-feu">

<header>
<h1>{{ nom }}</h1>
<p class="badges">
<span class="badge {{ badge_cycle.classe }}">{{ badge_cycle.label }}</span>
{% if badge_confiance %}<span class="badge">{{ badge_confiance }}</span>{% endif %}
</p>
<p class="dates">
{% if first_acq %}Première détection : {{ first_acq }}. {% endif %}
{% if last_acq %}Dernière observation : {{ last_acq }}.{% endif %}
</p>
</header>

{# Bandeau d'indicateurs — résumé visuel coloré par sévérité ; le détail suit ci-dessous #}
{% if indicateurs %}
<section class="indicateurs" aria-label="Indicateurs clés du feu">
{% for i in indicateurs %}
<div class="indic {{ i.statut }}">
<span class="lab">{{ i.label }}</span>
<span class="val">{{ i.valeur }}</span>
<span class="niv">{{ i.niveau }}</span>
</div>
{% endfor %}
</section>
{% endif %}

{# 3.2 Synthèse factuelle — le paragraphe citable (presse, moteurs génératifs) #}
<section class="synthese" aria-label="Synthèse factuelle">
{% for phrase in synthese %}
<p>{{ phrase }}</p>
{% endfor %}
</section>

{# 3.3 Carte du feu — enrichissement ; la synthèse ci-dessus en est l'alternative texte (§8) #}
<section class="carte-feu">
<h2>Carte du feu</h2>
<div class="legende-carte" aria-hidden="true">
<span><i class="pastille front_actif"></i> Zone détectée au dernier passage</span>
<span><i class="pastille recent"></i> Détectée il y a moins de 24 h</span>
<span><i class="pastille plus_detecte"></i> Plus détectée depuis plus de 24 h</span>
</div>
{% if enjeux_poi %}
<label class="toggle-poi"><input type="checkbox" id="toggle-poi" checked> Afficher les enjeux à proximité (campings, écoles, sites sensibles)</label>
{% if enjeux_poi_legende %}
{# Clé des marqueurs POI : couleur → catégorie (Spec 06 §4). Seules les catégories
   réellement présentes sur la carte (emprise + < 5 km) ; contour foncé = dans la zone. #}
<div class="legende-carte legende-poi" aria-hidden="true">
{% for e in enjeux_poi_legende %}<span><i class="pastille poi poi-{{ e.category }}"></i> {{ e.libelle }}</span>
{% endfor %}<span><i class="pastille poi poi-emprise"></i> Dans la zone détectée</span>
</div>
{% endif %}
{% endif %}
{% if imagerie_date %}
{# Imagerie satellite datée (Spec 06 §5, cran léger) — opt-in : calque de tuiles NASA GIBS
   sous les cellules du feu. Discipline P0 : légende « image à cette date, a pu évoluer ». #}
<label class="toggle-imagerie"><input type="checkbox" id="toggle-imagerie"> {{ imagerie_toggle }}</label>
{% endif %}
<div class="carte" data-carte="feu" data-geojson="feu.geojson"{% if imagerie_date %} data-img-date="{{ imagerie_date }}"{% endif %} role="img"
     aria-label="Carte des zones détectées du feu ; description complète dans la synthèse ci-dessus"></div>
{% if imagerie_date %}<p class="note imagerie-note" hidden id="imagerie-note">{{ imagerie_legende }}</p>{% endif %}
<noscript><p class="indispo">La carte interactive nécessite JavaScript. La synthèse et la chronologie ci-dessus décrivent le feu sans carte.</p></noscript>
</section>

{# 3.4 Communes concernées — paliers proches ouverts, paliers lointains repliés #}
{% if communes_groupes or communes_groupes_eloignes %}
<section class="communes">
<h2>Communes concernées</h2>
{% macro groupe_rel(groupe) %}
<div class="groupe-rel">
<h3>{{ groupe.titre }}</h3>
<ul>
{% for c in groupe.communes %}
<li><a href="{{ c.href }}">{{ c.nom }}</a>{% if c.interval %} — {{ c.interval }}{% endif %}</li>
{% endfor %}
</ul>
</div>
{% endmacro %}
{% for groupe in communes_groupes %}
{{ groupe_rel(groupe) }}
{% endfor %}
{% if communes_groupes_eloignes %}
<details class="communes-eloignees">
<summary>Communes à proximité (10 à 20 km)</summary>
{% for groupe in communes_groupes_eloignes %}
{{ groupe_rel(groupe) }}
{% endfor %}
</details>
{% endif %}
</section>
{% endif %}

{# Enjeux sensibles à proximité (Spec 06 §4) — AGRÉGÉ, jamais nominatif ni impact.
   Section absente tant qu'aucun référentiel POI n'est chargé (dégradé, pas d'affirmation
   d'absence sans référentiel — P6). #}
{% if enjeux_poi or not enjeux_indispo %}
<section class="enjeux">
<h2>Enjeux sensibles à proximité</h2>
{% if enjeux_poi %}
{% for p in enjeux_poi %}
<p>{{ p }}.</p>
{% endfor %}
{% else %}
<p class="calme">Aucun établissement sensible recensé à proximité.</p>
{% endif %}
<p class="note">{{ enjeux_reserve }}</p>
</section>
{% endif %}
{# 3.5 Chronologie + 3.6 intensité par passage — antichronologique, jour/nuit distingués #}
{% if chronologie %}
<section class="chronologie">
<h2>Chronologie des passages</h2>
<table>
<thead><tr><th>Heure (donnée)</th><th>Passage</th><th>Points chauds</th><th>Puissance thermique</th></tr></thead>
<tbody>
{% for l in chronologie %}
<tr><td>{{ l.at }}</td><td>{{ l.type }}</td><td>{{ l.n_hotspots }}</td>
<td>{% if l.frp %}{{ l.frp }} MW{% else %}—{% endif %}</td></tr>
{% endfor %}
</tbody>
</table>
<p class="note">Les passages de nuit et de jour ne sont pas comparables entre eux (sensibilité du capteur).</p>
</section>
{% endif %}

{# 3.7 Météo #}
{% if meteo_obs %}
<section class="meteo">
<h2>Météo</h2>
<p>{{ meteo_obs }}.</p>
</section>
{% endif %}

{# 3.8 Contexte sécheresse — mode dégradé tant que la source n'est pas armée (P6) #}
<section class="secheresse">
<h2>Contexte sécheresse</h2>
{% if secheresse_meteo_forets %}<p>{{ secheresse_meteo_forets }}.</p>{% endif %}
{% if secheresse_indispo %}
<p class="indispo">Contexte sécheresse momentanément indisponible (source en cours d'intégration).</p>
{% endif %}
{% if not secheresse_indispo and not secheresse_meteo_forets %}
<p class="calme">Aucune alerte sécheresse départementale en cours (Météo des forêts).</p>
{% endif %}
</section>

{# 3.9 Données brutes — second niveau, replié #}
<section class="brut">
<h2>Données brutes</h2>
<details>
<summary>Détections et export</summary>
<p>{{ brut.n_hotspots }} points chauds enregistrés · {{ brut.n_versions }} versions du feu.</p>
<p><a href="{{ brut.geojson_href }}">Télécharger le GeoJSON du feu</a></p>
</details>
</section>

</article>
{% endblock %}
{% block scripts %}
<script src="/static/js/maplibre-gl.js" defer></script>
<script src="/static/carte-config.js" defer></script>
<script src="/static/js/carte.js" defer></script>
{% endblock %}
