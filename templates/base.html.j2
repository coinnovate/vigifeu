{#
  Gabarit de base — squelette commun à toutes les pages (Spec 04 §2, §5).
  Contenu complet sans JavaScript (P3) ; le JS n'ajoute que carte et durées relatives.
  Aucune heure de génération ici (Spec 04 §9.5) : seuls les <time> de la donnée.
#}<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ page_title }}{% endblock %}</title>
<meta name="description" content="{% block description %}{{ page_description }}{% endblock %}">
<link rel="canonical" href="{{ base_url }}{{ canonical_path }}">
<meta property="og:site_name" content="{{ marque }}">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ page_title }}">
<meta property="og:description" content="{{ page_description }}">
<meta property="og:url" content="{{ base_url }}{{ canonical_path }}">
{% if og_image %}<meta property="og:image" content="{{ base_url }}{{ og_image }}">
<meta name="twitter:card" content="summary_large_image">{% endif %}
<link rel="stylesheet" href="/static/css/vigifeu.css">
{% if analytics.get('umami_src') %}<script defer src="{{ analytics.umami_src }}" data-website-id="{{ analytics.umami_website_id }}"></script>{% endif %}
{% if jsonld %}<script type="application/ld+json">{{ jsonld|safe }}</script>{% endif %}
{% block extra_head %}{% endblock %}
</head>
<body>
<a class="skip" href="#contenu">Aller au contenu</a>
<header class="site">
<a class="marque-logo" href="/" aria-label="{{ marque }} — accueil">
<img src="/static/img/logo.png" alt="{{ marque }}" width="1527" height="489">
</a>
<nav class="fil" aria-label="Fil d'Ariane">
<ol>
{% for miette in fil_ariane %}
<li>{% if miette.href %}<a href="{{ miette.href }}">{{ miette.label }}</a>{% else %}<span aria-current="page">{{ miette.label }}</span>{% endif %}</li>
{% endfor %}
</ol>
</nav>
</header>
<main id="contenu">
{% block content %}{% endblock %}
</main>
{% include "_footer.html.j2" %}
{% block scripts %}{% endblock %}
</body>
</html>
