{% extends "base.html.j2" %}
{#
  Carte nationale — page d'accueil (Spec 04 §8). La carte est un enrichissement ; la
  liste des feux ci-dessous est le contenu complet sans JS et le maillage interne.
#}
{% block extra_head %}
<link rel="stylesheet" href="/static/css/maplibre-gl.css">
{% endblock %}
{% block content %}
<article class="accueil">
<h1>Incendies de végétation en France</h1>
<p>Suivi satellite en continu (NASA FIRMS). Sélectionnez un feu pour sa fiche détaillée.</p>

<div class="carte" data-carte="national" data-geojson="{{ geojson_href }}" role="img"
     aria-label="Carte des feux de végétation en cours en France ; liste complète ci-dessous"></div>
<noscript><p class="indispo">La carte interactive nécessite JavaScript. La liste des feux en cours ci-dessous est complète sans carte.</p></noscript>

<section class="feux-en-cours">
<h2>Feux suivis en cours</h2>
{% if feux %}
<ul class="liste-feux">
{% for f in feux %}
<li class="feu-item">
  <div class="feu-titre">
    <a href="{{ f.url }}">{{ f.nom }}</a>
    {% if f.nouveau %}<span class="tag-nouveau">{{ f.nouveau }}</span>{% endif %}
    <span class="badge {{ f.classe }}">{{ f.badge }}</span>
  </div>
  {% if f.surface or f.detecte_le %}
  <div class="feu-meta">
    {%- if f.surface %}<span class="feu-surface">{{ f.surface }}</span>{% endif -%}
    {%- if f.surface and f.detecte_le %} · {% endif -%}
    {%- if f.detecte_le %}<span class="feu-date">dernière détection {{ f.detecte_le }}</span>{% endif -%}
  </div>
  {% endif %}
</li>
{% endfor %}
</ul>
{% else %}
<p class="calme">Aucun feu de végétation suivi actuellement à l'échelle nationale.</p>
{% endif %}
<p><a href="/departements/">Parcourir les incendies par département →</a></p>
</section>
</article>
{% endblock %}
{% block scripts %}
<script src="/static/js/maplibre-gl.js" defer></script>
<script src="/static/carte-config.js" defer></script>
<script src="/static/js/carte.js" defer></script>
{% endblock %}
